<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Luka Rekhviashvili{% endblock %}</title>

    <style>
        /* 1. Global Styles */
        body {
            margin-left: 5%;
            margin-right: 50%;
            font-family: "Times New Roman", Times, serif; /* Classic Prof Dr font */
        }

        /* 2. Hide Mobile elements by default (Desktop view) */
        .mobile-only { 
            display: none; 
        }

        /* 3. The "Switch" (Media Query) */
        @media only screen and (max-width: 600px) {
            /* Hide Desktop-only stuff */
            .desktop-only { 
                display: none !important; 
            }

            /* Show Mobile-only stuff */
            .mobile-only { 
                display: block !important;
                margin-left: 2%;
                margin-right: 2%; /* Don't use 50% here or text will be too thin */
            }

            body { 
                font-size: 18px; 
                margin-left: 2%; 
                margin-right: 2%;
            }
        }
    </style>

</head>
<body>
    <br>
    <header>
        <td align="left" valign="top"><b><font size="5">{%block head%}Luka Rekhviashvili{% endblock %}</font></b><br>
        <i>{%block subhead%}Abiturient/Senior Student, pulchritudinous{% endblock %}</i>
        <br>
        {%block extra%}
        {% endblock %}
    </header>
    <br>    
    <hr>
    
    {% block content %}{% endblock %}
    
    <br><br><br>
    <footer>
    <hr>
    <p style="margin: 0;">last modified: {{ last_modified }}</p>
    </footer>
</body>
</html>