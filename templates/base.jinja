<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Luka Rekhviashvili{% endblock %}</title>

    <style>
        /* 1. Global Styles */
        body {
            margin-left: 5%;
            margin-right: 50%;
            font-family: "Times New Roman", Times, serif; /* Classic Prof Dr font */
        }

        /* 2. Hide Mobile elements by default (Desktop view) */
        .mobile-only { 
            display: none; 
        }

        /* 3. The "Switch" (Media Query) */
        @media only screen and (max-width: 600px) {
            .desktop-only { display: none !important; }
            .mobile-only { 
                display: block !important;
                margin-left: 2%;
                margin-right: 2%; 
            }
            body { 
                font-size: 18px; 
                margin-left: 2%; 
                margin-right: 2%;
            }
        }

        /* 4. Ensure header alignment */
        .header-table {
            width: 100%;
            border-collapse: collapse;
        }
        .header-table td {
            vertical-align: top;
        }
    </style>

</head>
<body>
    <br>
    <header>
        <table class="header-table" border="0" cellpadding="0" cellspacing="15">
            <tr>
                <td align="left" valign="top" class="desktop-only">
                    {% block portrait %}{% endblock %}
                </td>
                <td align="left" valign="top">
                    <b><font size="5">{%block head%}Luka Rekhviashvili{% endblock %}</font></b><br>
                    <i>{%block subhead%}Abiturient/Senior Student, pulchritudinous{% endblock %}</i>
                    <br>
                    {%block extra%}
                    {% endblock %}
                </td>
            </tr>
        </table>
    </header>
    <br>    
    <hr>
    
    {% block content %}{% endblock %}
    
    <br><br><br><br><br><br>
    <footer>
    <hr>
    <p><a href="main.html">[ &lt;&lt; return to main index ]</a></p>
    <p style="margin: 0;">last modified: {{ last_modified }}</p>
    </footer>
</body>
</html>
