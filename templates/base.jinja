<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Luka Rekhviashvili{% endblock %}</title>

    {% block meta %}
    <meta name="description" content="{% block meta_description %}Personal site of Luka Rekhviashvili — student, researcher, and builder.{% endblock %}">
    <meta name="keywords" content="{% block keywords %}Luka Rekhviashvili{% endblock %}">
    <meta name="author" content="Luka Rekhviashvili">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://luka-rekhviashvili.com/{% block canonical %}index.html{% endblock %}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Luka Rekhviashvili">
    <meta property="og:title" content="{% block og_title %}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{% endblock %}">
    <meta property="og:url" content="https://luka-rekhviashvili.com/{% block og_url %}{% endblock %}">
    {% block og_image %}<meta property="og:image" content="https://luka-rekhviashvili.com/portrait.jpg">{% endblock %}

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{% block twitter_title %}{% endblock %}">
    <meta name="twitter:description" content="{% block twitter_description %}{% endblock %}">
    <meta name="twitter:image" content="https://luka-rekhviashvili.com/portrait.jpg">
    {% endblock %}

    <style>
        /* 1. Global Styles */
        body {
            /* Flexbox setup for the sticky footer */
            display: flex;
            flex-direction: column;
            min-height: 100vh; /* Ensures the body is at least as tall as the screen */
            
            margin-top: 0;
            margin-left: 5%;
            margin-right: 50%;
            font-family: "Times New Roman", Times, serif; /* Classic Prof Dr font */
        }

        /* 2. Hide Mobile elements by default (Desktop view) */
        .mobile-only { 
            display: none; 
        }

        /* 3. The "Switch" (Media Query) */
        @media only screen and (max-width: 600px) {
            .desktop-only { display: none !important; }
            .mobile-only { 
                display: block !important;
                margin-left: 2%;
                margin-right: 2%; 
            }
            body { 
                font-size: 18px; 
                margin-left: 2%; 
                margin-right: 2%;
            }
        }

        /* 4. Ensure header alignment */
        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 40px; /* Replaces the top <br> */
        }
        .header-table td {
            vertical-align: top;
        }

        .portrait-cell {
            width: 144px; 
            min-width: 144px; 
            max-width: 144px;
            padding-right: 10px; 
        }

        hr {
            width: 100%;
            display: block;
        }

        /* 5. Footer styling */
        footer {
            margin-top: auto; /* This magically pushes the footer to the bottom */
            padding-bottom: 20px; /* Gives some breathing room at the bottom of the page */
        }

        /* 6. Partner toggle */
        body.dark-mode {
            background: black;
            color: white;
        }
        body.dark-mode a {
            color: white;
        }
        body.dark-mode a:visited {
            color: #ccc;
        }
        body.dark-mode hr {
            border-color: white;
        }
        .partner-only {
            display: none;
        }
        body.partner-view .luka-only {
            display: none;
        }
        body.partner-view .partner-only {
            display: block;
        }
        .toggle-btn {
            background: none;
            border: none;
            font-family: inherit;
            font-size: 0.7em;
            cursor: pointer;
            padding: 0;
            margin-left: 6px;
            color: inherit;
            text-decoration: underline;
            text-decoration-style: dotted;
        }
    </style>

</head>
<body>
    <header>
        <table class="header-table" border="0" cellpadding="0" cellspacing="15">
            <tr>
                {% block portrait %}{% endblock %}
                <td align="left" valign="top">
                    <b><font size="5">{%block head%}Luka Rekhviashvili{% endblock %}</font></b><br>
                    <i>{%block subhead%}Abiturient/Senior Student, pulchritudinous{% endblock %}</i>
                    <br>
                    {%block extra%}
                    {% endblock %}
                </td>
                {% block right %}{% endblock %}
            </tr>
        </table>
    </header>
    <br>    
    <hr>
    
    {% block content %}{% endblock %}
    
    <footer>
        <hr>
        {% block footer_links %}
        <p><a href="index.html">[ &lt;&lt; return to main index ]</a></p>
        {% endblock %}
        <p style="margin: 0;">last modified: {{ last_modified }}</p>
    </footer>
</body>
</html>
